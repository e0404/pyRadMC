    affiliation: German Cancer Research Center (DKFZ)
    orcid: "https://orcid.org/0000-0002-1451-223X"
version: 0.2.1
date-released: "2026-09-06"
license: Apache-2.0
repository-code: "https://github.com/e0404/pyRadMC"
url: "https://pyradmc.readthedocs.io"
keywords:
  - Monte Carlo
  - radiotherapy
  - dose calculation
  - treatment planning
  - dose influence matrix
  - GPU computing
