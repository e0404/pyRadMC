#!/bin/sh
# Pre-commit gate: lint, format, types, fast test tiers (AGENTS.md sections 4 and 5).
#
# Versioned hook, no extra dependencies. Enable once per clone with:
#     make hooks        (or: git config core.hooksPath .githooks)
#
# Bypassing with --no-verify is for emergencies, and CI-equivalent checks still apply.
set -e

if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"      # Windows venv
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"              # POSIX venv
else
    PY="python"
fi

echo "pre-commit: ruff check"
"$PY" -m ruff check .

echo "pre-commit: ruff format --check"
"$PY" -m ruff format --check .

echo "pre-commit: mypy --strict (non-kernel code)"
"$PY" -m mypy pyRadMC

echo "pre-commit: fast test tiers (unit, physics, integration, dij)"
"$PY" -m pytest -q

echo "pre-commit: all gates passed"
